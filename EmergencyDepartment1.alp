						<Parameter>
							<Name><![CDATA[onEnterDelay]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[
Patient paziente = (Patient) agent;

double attesa = time() - paziente.tempoIngresso;
attesaPrimaVisita.add(attesa);

if (paziente.severityCode == 1) {
    attesaCodice1.add(attesa);
} else if (paziente.severityCode == 2) {
    attesaCodice2.add(attesa);
} else if (paziente.severityCode == 3) {
    attesaCodice3.add(attesa);
} else if (paziente.severityCode == 4) {
    attesaCodice4.add(attesa);
}
]]></Code>
							</Value>
