			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<InitialSetupCode><![CDATA[traceln("Scenari previsti: " + getMaximumIterations());

try (java.io.PrintWriter out = new java.io.PrintWriter(
    new java.io.FileWriter(
        System.getProperty("user.home") + "/risultati_pronto_soccorso.csv",
        false
    )
)) {
    out.println(
        "Medici,Infermieri,Letti,AttesaMedia," +
        "AttesaCodice1,AttesaCodice2,AttesaCodice3,AttesaCodice4," +
        "UtilizzoMedici,UtilizzoInfermieri,PazientiUsciti"
    );
} catch (java.io.IOException e) {
    traceln("ERRORE CSV: " + e.getMessage());
}]]></InitialSetupCode>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[
datiAttesa.add(root.attesaPrimaVisita.mean());
datiAttesaMedico.add(root.attesaPrimaVisita.mean());
datiMediciData.add(root.medici.utilization());
datiUtilizzoInfermieri.add(root.infermieri.utilization());

datiAbbandono.add(
    (root.sink.count() + root.sink2.count()) > 0
    ? (double) root.sink2.count() / (root.sink.count() + root.sink2.count())
    : 0.0
);

traceln(
    "Medici=" + root.numeroMedici +
    " | Infermieri=" + root.numeroInfermieri +
    " | Letti=" + root.numeroLetti +
    " | AttesaMedia=" + root.attesaPrimaVisita.mean()
);

try (java.io.PrintWriter out = new java.io.PrintWriter(
    new java.io.FileWriter(
        System.getProperty("user.home") + "/risultati_pronto_soccorso.csv",
        true
    )
)) {
    out.println(
        root.numeroMedici + "," +
        root.numeroInfermieri + "," +
        root.numeroLetti + "," +
        root.attesaPrimaVisita.mean() + "," +
        root.attesaCodice1.mean() + "," +
        root.attesaCodice2.mean() + "," +
        root.attesaCodice3.mean() + "," +
        root.attesaCodice4.mean() + "," +
        root.medici.utilization() + "," +
        root.infermieri.utilization() + "," +
        (root.sink.count() + root.sink2.count())
    );
} catch (java.io.IOException e) {
    traceln("ERRORE CSV: " + e.getMessage());
}]]></AfterSimulationRunCode>
